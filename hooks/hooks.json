{
  "description": "Forward completed Codex turns to the configured webhook.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/webhook_notify.sh\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\scripts\\webhook_notify.ps1\"",
            "timeout": 20,
            "statusMessage": "Sending task notification"
          }
        ]
      }
    ]
  }
}
